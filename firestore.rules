rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    // FCM tokens + notificationSettings
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid);

      match /devices/{deviceId} {
        allow read, write: if isSelf(uid);
      }
    }

    // Internal digest queue — only Cloud Functions (Admin SDK) write.
    match /pendingDigests/{digestId} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if signedIn()
                    && resource.data.ownerId == request.auth.uid;

      match /attendees/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }

      match /eventChat/{messageId} {
        allow read: if signedIn()
                    && exists(/databases/$(database)/documents/events/$(eventId)/attendees/$(request.auth.uid));
        allow create: if signedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && exists(/databases/$(database)/documents/events/$(eventId)/attendees/$(request.auth.uid));
      }
    }

    match /event_comments/{eventId} {
      allow read, write: if signedIn();
    }

    match /eventMeetupCampaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.organizerId == request.auth.uid
                    && request.resource.data.billingTier in ['free', 'paid']
                    && request.resource.data.targetGroupSize is int
                    && request.resource.data.targetGroupSize >= 2
                    && request.resource.data.targetGroupSize <= 6;
      // Организатор — полный апдейт; остальные — только metrics (soft analytics).
      allow update: if signedIn() && (
        resource.data.organizerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['metrics', 'updatedAt'])
      );
      allow delete: if signedIn()
                    && resource.data.organizerId == request.auth.uid;
    }

    match /meetings/{meetingId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.maxParticipants >= 2
                    && request.resource.data.maxParticipants <= 6
                    && request.resource.data.topic.size() <= 60;

      allow update: if signedIn()
                    && (
                      resource.data.creatorId == request.auth.uid
                      || request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['currentParticipantCount', 'status', 'updatedAt'])
                    );

      allow delete: if signedIn()
                    && resource.data.creatorId == request.auth.uid;

      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && (
          request.auth.uid == uid
          || (
            get(/databases/$(database)/documents/meetings/$(meetingId)).data.creatorId
              == request.auth.uid
            && request.resource.data.status == 'invited'
          )
        );
        allow update: if isSelf(uid);
        allow delete: if isSelf(uid)
                      || get(/databases/$(database)/documents/meetings/$(meetingId)).data.creatorId
                           == request.auth.uid;
      }

      match /chat/{messageId} {
        allow read: if signedIn()
                    && exists(/databases/$(database)/documents/meetings/$(meetingId)/participants/$(request.auth.uid));
        allow create: if signedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && exists(/databases/$(database)/documents/meetings/$(meetingId)/participants/$(request.auth.uid));
      }
    }
  }
}
